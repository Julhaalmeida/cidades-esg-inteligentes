# =============================================================================
# Variáveis de ambiente do Docker Compose.
#   1) Copie este arquivo:  cp .env.example .env    (Windows: copy .env.example .env)
#   2) Troque a senha do banco.
# O arquivo .env NUNCA deve ir para o Git (já está no .gitignore).
# =============================================================================

# ---- Aplicação ----
# Nome do ambiente exibido em /api/info e na página inicial (local, staging, production)
APP_ENV=local
# Perfil do Spring: default, staging ou production
SPRING_PROFILES_ACTIVE=default
# Porta publicada no seu computador (http://localhost:8080)
APP_PORT=8080
LOG_LEVEL_APP=INFO
SWAGGER_ENABLED=true

# ---- Banco de dados (PostgreSQL) ----
DB_NAME=cidades_esg
DB_USER=esg
DB_PASSWORD=troque-esta-senha
# Schema do banco usado pela aplicação (o Flyway cria se não existir)
DB_SCHEMA=public

# ---- Ferramentas opcionais (docker compose --profile tools up -d) ----
ADMINER_PORT=8090
